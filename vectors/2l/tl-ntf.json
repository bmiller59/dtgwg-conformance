    {
      "id": "TL-NTF-004",
      "title": "notifications/notify 0.1: a schema-valid, signed, addressed request is not refused for an envelope reason, and any response conforms to the response schema",
      "tier": 1,
      "spec": [
        "SPEC.md:1011-1023 (7.2 consumer rules 1-13: none of the rejection grounds applies to this request, so a refusal must not carry their codes, section 8.3)",
        "SPEC.md 4.4.1 (the reply dispositions) and 7.1 item 3 (a response payload validates against the schema of its type)",
        "SPEC.md:246, :1069 (a consumer MAY require its own ext namespace and then rejects a document lacking it with malformedRequest) and SPEC.md:388 (MAY reject a non-canonical VID-typed member with malformedRequest): where the payload schema admits ext, a malformedRequest here is recorded as a note and is not escalated on the attested profile",
        "payload and response schemas of https://trusttasks.org/spec/notifications/notify/0.1 (@openvtc/trust-tasks 0.29.0 (registry package; the specification is status draft))",
        "response type https://trusttasks.org/spec/notifications/notify/0.1#response",
        "specs/notifications/notify/0.1/spec.md (task-force checkout origin/main 98dda36f8 (2026-11-24), specification status draft)",
        "Mechanics only: this vector does not assert that the request is authorised, admitted, retained or what it does (that is the deployment's governance)."
      ],
      "clarify": null,
      "requires": [
        "https://trusttasks.org/spec/notifications/notify/0.1"
      ],
      "mutants": [
        "plainBadResponse"
      ],
      "steps": [
        {
          "send": {
            "document": {
              "id": "$id(a1)",
              "type": "https://trusttasks.org/spec/notifications/notify/0.1",
              "issuer": "$A",
              "recipient": "$iut",
              "issuedAt": "$now+0s",
              "payload": {
                "notification": {
                  "notificationId": "did:web:alice.example",
                  "revision": 1,
                  "kind": "zQmb1XVvHqbCe5nUPFxpJcRz3RtP4pQyKgTsWJgNBzVhE7d",
                  "subject": {
                    "heldBy": "did:web:alice.example",
                    "id": "example",
                    "openWith": "https://example.org/x"
                  },
                  "audience": "did:web:alice.example",
                  "status": "available",
                  "relayable": false
                }
              }
            }
          },
          "expect": {
            "disposition": "answered",
            "plainType": "https://trusttasks.org/spec/notifications/notify/0.1"
          }
        }
      ],
