      },
      "clarify": null,
      "requires": [
        "carrier:consequential",
        "binding:https",
        "optional:transportIdentity"
      ],
      "mutants": [
        "ignoreTransportIdentity",
        "mismatchRoutedToIssuer",
        "leakIdentityInMessage"
      ],
      "steps": [
        {
          "send": {
            "template": "carrier.request",
            "http": {},
            "from": {
              "spoof": "X"
            }
          },
          "expect": {
            "disposition": "error",
            "code": "identityMismatch",
            "noSideEffect": true,
            "httpStatusShould": 422,
            "httpBody": "json"
          }
        },
        {
          "send": {
            "template": "carrier.request",
            "params": {
              "id": "$id(r2)"
            },
            "http": {}
          },
          "expect": {
            "disposition": "response",
            "httpStatusShould": 200,
            "state": {
              "handled": 1
            }
          }
        }
      ],
      "advisoryMutants": [
        "httpStatusFlat"
      ]
    },
    {
      "id": "BND-003",
      "title": "a request with no Authorization header has no transport-authenticated sender and is judged on its proof",
      "tier": 1,
      "spec": [
        "bindings/https/0.3/spec.md:53 (no Authorization: no transport-authenticated sender)",
        "bindings/https/0.3/spec.md:124 (absent for requests with no Authorization header)"
      ],
