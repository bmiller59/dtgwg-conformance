                "op": "set",
                "path": "/threadId",
                "value": "urn:uuid:tampered",
                "afterSign": true
              }
            ]
          },
          "expect": {
            "disposition": "error",
            "code": "proofInvalid",
            "noSideEffect": true,
            "httpBody": "json"
          }
        },
        {
          "send": {
            "template": "carrier.request",
            "params": {
              "id": "$id(r6)",
              "recipient": "$X"
            },
            "http": {}
          },
          "expect": {
            "disposition": "error",
            "code": "wrongRecipient",
            "noSideEffect": true,
            "httpBody": "json"
          }
        },
        {
          "send": {
            "template": "carrier.request",
            "params": {
              "id": "$id(r7)"
            },
            "http": {}
          },
          "expect": {
            "disposition": "response",
            "httpStatusShould": 200,
            "state": {
              "handled": 2
            }
          }
        },
        {
          "send": {
            "same": "previous",
            "mutate": [
              {
                "op": "set",
                "path": "/threadId",
                "value": "urn:uuid:other-content"
              }
            ],
            "sign": {
              "as": "A"
            },
            "http": {}
          },
          "expect": {
            "disposition": "error",
            "code": "idConflict",
            "noSideEffect": true,
            "httpBody": "json"
          }
        }
      ],
      "synthetic": true
    },
