    {
      "id": "BND-001",
      "title": "only POST /trust-tasks is accepted: another method is 405 and another path is 404, neither with a framework error document",
      "tier": 1,
      "spec": [
        "bindings/https/0.3/spec.md:52 (reject every other method/path combination with 405 / 404; not framework error documents)"
      ],
      "source": {
        "slug": "bindings/https",
        "version": "0.3",
        "channel": "registry",
        "ref": "kit:bindings/https/0.3",
        "pinnedDigest": "sha256:5b863795a0c95ba58489f9913c4d39d47cd26bd14d99b5b89e6ef354ad1c517c",
        "tfRef": {
          "repoPath": "bindings/https/0.3/spec.md",
          "commit": "bd0c05013277b83f23fa90db699671ebb48dd24c",
          "status": "main"
        },
        "tfCommit": "bd0c05013277b83f23fa90db699671ebb48dd24c",
        "specHash": "sha256:6dba67e525ce25b99cb57158fa13be6a5a9e4cc1462665ce944b7ecd7f545b24"
      },
      "clarify": null,
      "requires": [
        "carrier:consequential",
        "binding:https"
      ],
      "mutants": [
        "httpAnyMethod",
        "httpAnyPath",
        "httpMethodStatus400",
        "httpRefusalAsErrorDoc"
      ],
      "steps": [
        {
          "send": {
            "template": "carrier.request",
            "http": {
              "method": "GET"
            }
          },
          "expect": {
            "disposition": "silence",
            "noSideEffect": true,
            "httpStatus": 405,
            "httpBody": "none"
          }
        },
        {
          "send": {
            "template": "carrier.request",
            "params": {
              "id": "$id(r2)"
            },
            "http": {
              "method": "PUT"
            }
          },
          "expect": {
            "disposition": "silence",
            "noSideEffect": true,
            "httpStatus": 405,
            "httpBody": "none"
          }
        },
        {
          "send": {
            "template": "carrier.request",
            "params": {
              "id": "$id(r3)"
            },
            "http": {
              "method": "DELETE"
            }
          },
          "expect": {
            "disposition": "silence",
            "noSideEffect": true,
            "httpStatus": 405,
            "httpBody": "none"
          }
        },
        {
          "send": {
            "template": "carrier.request",
            "params": {
              "id": "$id(r4)"
            },
            "http": {
              "path": "/trust-task"
            }
          },
          "expect": {
            "disposition": "silence",
            "noSideEffect": true,
            "httpStatus": [
              404,
              405
            ],
            "httpBody": "none"
          }
        },
        {
          "send": {
            "template": "carrier.request",
            "params": {
              "id": "$id(r5)"
            },
            "http": {}
          },
          "expect": {
            "disposition": "response",
            "httpStatus": 200,
            "state": {
              "handled": 1
            }
          }
        }
      ]
    },
    {
      "id": "BND-002",
      "title": "the bearer-authenticated sender is the transport identity: a different in-band issuer is identityMismatch (422), routed to the authenticated sender",
      "tier": 1,
      "spec": [
        "bindings/https/0.3/spec.md:53 (map the bearer token to a VID)",
        "bindings/https/0.3/spec.md:124 (the in-band issuer is cross-checked against it; mismatch is identityMismatch)",
        "bindings/https/0.3/spec.md:131 (route the error to the sender actually authenticated, never to the contested issuer)",
        "bindings/https/0.3/spec.md:129 (the token-to-VID mapping is deployment-defined, so the vector runs where the transport authenticates the sender)",
        "bindings/https/0.3/spec.md:135 (the status mapping is a SHOULD)"
      ],
      "source": {
        "slug": "bindings/https",
        "version": "0.3",
        "channel": "registry",
        "ref": "kit:bindings/https/0.3",
        "pinnedDigest": "sha256:5b863795a0c95ba58489f9913c4d39d47cd26bd14d99b5b89e6ef354ad1c517c",
        "tfRef": {
          "repoPath": "bindings/https/0.3/spec.md",
