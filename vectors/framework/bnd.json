      "tier": 1,
      "spec": [
        "bindings/https/0.3/spec.md:161 (Content-Type application/json for every single-document answer)",
        "bindings/https/0.3/spec.md:135 (the status mapping is a SHOULD; the codes themselves are BND-007)",
        "bindings/https/0.3/spec.md:139 (200 for a response)"
      ],
