      },
      "clarify": null,
      "requires": [
        "carrier:consequential",
        "discovery",
        "optional:discovery.acceptanceWindow"
      ],
      "mutants": [
        "discoveryWindowWiderMaxAge",
        "discoveryWindowWiderSkew"
      ],
      "steps": [
        {
          "send": {
            "template": "discovery.request"
          },
          "capture": {
            "maxAge": "/payload/acceptanceWindow/maxAgeSeconds",
            "skew": "/payload/acceptanceWindow/clockSkewSeconds"
          },
          "expect": {
            "disposition": "response",
            "type": "$discoveryResponse",
            "noSideEffect": true,
            "discovery": {
              "matches": []
            }
          }
        },
        {
          "at": "+0s",
          "send": {
            "template": "carrier.request",
            "params": {
              "id": "$id(old)",
              "issuedAt": "$nowAt(-maxAge)"
            }
          },
          "expect": {
            "disposition": "response",
            "state": {
              "handled": 1
            }
          }
        },
        {
          "send": {
            "template": "carrier.request",
            "params": {
              "id": "$id(ahead)",
              "issuedAt": "$nowAt(+skew)"
            }
          },
          "expect": {
            "disposition": "response",
            "state": {
              "handled": 2
            }
          }
        }
      ]
    },
