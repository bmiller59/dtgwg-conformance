    {
      "id": "DIS-012",
      "title": "the response states a window no wider than the one enforced: a document at the advertised maximum age, and one at the advertised skew ahead, are accepted",
      "tier": 1,
      "spec": [
        "specs/trust-task-discovery/0.4/spec.md:130-133 (responder rules, the MUST sentences at 132: a responder MUST state a window no wider than the one it applies)",
        "specs/trust-task-discovery/0.4/spec.md:124 (refuses past acceptance end plus skew, or issuedAt beyond now plus skew)",
        "specs/trust-task-discovery/0.3/spec.md:121-123 (responder rule 1: a responder MUST state a window no wider than the one it applies)",
        "specs/trust-task-discovery/0.3/spec.md:117 (the refusal rule: now > issuedAt + maxAgeSeconds + clockSkewSeconds, or issuedAt > now + clockSkewSeconds)"
      ],
      "source": {
        "slug": "trust-task-discovery",
        "version": "0.4",
        "channel": "registry",
        "ref": "kit:specs/trust-task-discovery/0.4",
