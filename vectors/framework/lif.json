  "vectors": [
    {
      "id": "LIF-001",
      "title": "a responded document stays responded; an inbound error does not change it",
      "tier": 1,
      "spec": [
        "framework 4.12 (responded is terminal)"
      ],
      "source": {
        "slug": "trust-task-framework",
        "version": "0.6.0",
        "channel": "registry",
        "ref": "kit:SPEC.md",
        "pinnedDigest": "sha256:fd038f5a87c30549324fe6ad542cc3cb223eb9148032658fa9d3c8d981974725",
        "tfRef": {
          "repoPath": "SPEC.md",
          "commit": "98dda36f854ba028205923866450dbc1753c3bf6",
          "status": "main"
        },
        "tfCommit": "98dda36f854ba028205923866450dbc1753c3bf6",
        "specHash": "sha256:720c71f0ad54cae84fa7d92e04f749d8341bab163755983d7aff0cb17cba3074"
      },
      "clarify": "A responded document stays responded (4.12) is stated, but the second half, an inbound error answered with nothing, is not stated by any sentence; the same behaviour as ERR-008. Not gating.",
      "clarifyClass": "vector-overreads",
      "clarifySince": "0.1.0-draft",
      "clarifyQuestions": [],
      "mutants": [
        "errorFlipsState",
        "answerInboundErrors"
      ],
      "steps": [
        {
          "send": {
            "template": "carrier.request"
          },
          "expect": {
            "disposition": "response",
            "state": {
              "handled": 1
            }
          }
        },
        {
          "send": {
            "template": "error.inbound"
          },
          "expect": {
            "disposition": "silence",
            "state": {
              "handled": 1,
              "documentState": {
                "$id(req)": "responded"
              }
            }
          }
        }
      ],
      "requires": [
        "carrier:consequential"
      ]
    },
    {
      "id": "LIF-002",
      "title": "a document refused before acceptance writes no record: a corrected resend under the same id is accepted",
      "tier": 1,
      "spec": [
        "framework 4.12 (the record is written at accepted)",
        "SPEC.md:1021 (7.2 item 11)",
        "SPEC.md:1071 (the error reply is a SHOULD)"
      ],
      "source": {
        "slug": "trust-task-framework",
        "version": "0.6.0",
        "channel": "registry",
        "ref": "kit:SPEC.md",
        "pinnedDigest": "sha256:fd038f5a87c30549324fe6ad542cc3cb223eb9148032658fa9d3c8d981974725",
        "tfRef": {
          "repoPath": "SPEC.md",
          "commit": "98dda36f854ba028205923866450dbc1753c3bf6",
          "status": "main"
        },
        "tfCommit": "98dda36f854ba028205923866450dbc1753c3bf6",
        "specHash": "sha256:720c71f0ad54cae84fa7d92e04f749d8341bab163755983d7aff0cb17cba3074"
      },
      "clarify": "The framework writes the duplicate record at accepted (4.12), so a refusal before acceptance need not burn the id, and VTI releases a refused claim; but the text does not state the corrected-resend behaviour (the same scenario as DUP-009, which is CLARIFY). Not gating.",
      "clarifyClass": "spec-silent",
      "clarifySince": "0.1.0-draft",
      "clarifyQuestions": [],
      "mutants": [
        "burnIdOnRefusal"
      ],
      "steps": [
        {
          "send": {
            "template": "carrier.request",
            "params": {
              "payload": {
                "$carrierInvalid": true
              }
            }
          },
          "expect": {
            "disposition": "error",
            "code": "malformedRequest",
            "noSideEffect": true,
            "errorReply": "should"
          }
        },
        {
          "at": "+1s",
          "send": {
            "template": "carrier.request"
          },
          "expect": {
            "disposition": "response",
            "state": {
              "handled": 1
            }
          }
        }
      ],
      "requires": [
        "carrier:consequential"
      ]
    },
    {
