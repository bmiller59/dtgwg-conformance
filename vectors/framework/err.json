        "specHash": "sha256:720c71f0ad54cae84fa7d92e04f749d8341bab163755983d7aff0cb17cba3074"
      },
      "clarify": "No sentence of the specifications says an inbound error is answered with nothing. VTI does that (docs/05 section 1.1) and ERR-008, the same behaviour, is CLARIFY. Not gating.",
      "clarifyClass": "vector-overreads",
      "clarifySince": "0.1.0-draft",
      "clarifyQuestions": [],
      "mutants": [
        "answerInboundErrors"
      ],
      "steps": [
        {
          "send": {
            "template": "error.inbound"
          },
          "expect": {
            "disposition": "silence",
            "noSideEffect": true
          }
        }
      ],
      "requires": [
        "carrier:consequential"
      ]
    },
