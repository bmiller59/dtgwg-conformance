  "vectors": [
    {
      "id": "ERR-001",
      "title": "error shape, threading, inResponseTo and bounded details",
      "tier": 1,
      "spec": [
        "framework 8.2",
        "framework 8.2.2",
        "framework 8.4"
      ],
      "source": {
        "slug": "trust-task-framework",
        "version": "0.6.0",
        "channel": "registry",
        "ref": "kit:SPEC.md",
        "pinnedDigest": "sha256:fd038f5a87c30549324fe6ad542cc3cb223eb9148032658fa9d3c8d981974725",
        "tfRef": {
          "repoPath": "SPEC.md",
          "commit": "98dda36f854ba028205923866450dbc1753c3bf6",
          "status": "main"
        },
        "tfCommit": "98dda36f854ba028205923866450dbc1753c3bf6",
        "specHash": "sha256:720c71f0ad54cae84fa7d92e04f749d8341bab163755983d7aff0cb17cba3074"
      },
      "clarify": null,
      "mutants": [
        "errorWithoutRetryable",
        "reuseRequestIdInReply",
        "oversizedDetails",
        "expiredAsMalformed"
      ],
      "steps": [
        {
          "at": "+0s",
          "send": {
            "template": "carrier.request",
            "params": {
              "expiresAt": "$nowAt(-windowSkew,-10s)",
              "issuedAt": "$nowAt(-windowSkew,-20s)"
            }
          },
          "expect": {
            "disposition": "error",
            "code": "expired",
            "retryable": false,
            "noSideEffect": true,
            "pointer": {
              "/payload/inResponseTo/typeUri": "$carrier",
              "/payload/inResponseTo/id": "$id(req)"
            }
          }
        }
      ],
      "advisoryMutants": [
        "wrongReplyThread"
      ],
      "requires": [
        "carrier:consequential"
      ]
    },
    {
      "id": "ERR-002",
      "title": "an inbound error is never answered",
      "tier": 1,
      "spec": [
        "docs/05 section 1.1 (VTI precedent: an inbound error is dropped, not answered); no specification sentence states it"
      ],
      "source": {
        "slug": "trust-task-framework",
        "version": "0.6.0",
        "channel": "registry",
        "ref": "kit:SPEC.md",
        "pinnedDigest": "sha256:fd038f5a87c30549324fe6ad542cc3cb223eb9148032658fa9d3c8d981974725",
        "tfRef": {
