    {
      "id": "ERR-005",
      "title": "retryable defaults: refusals the producer cannot cure by resending are not marked retryable",
      "tier": 1,
      "spec": [
        "SPEC.md:1315 (8.3 default retryable, SHOULD unless task-specific knowledge dictates otherwise)",
        "SPEC.md:1342-1346 (8.4 retry means the identical document)"
      ],
      "source": {
        "slug": "trust-task-framework",
        "version": "0.6.0",
        "channel": "registry",
        "ref": "kit:SPEC.md",
        "pinnedDigest": "sha256:fd038f5a87c30549324fe6ad542cc3cb223eb9148032658fa9d3c8d981974725",
