        {
          "send": {
            "template": "error.inbound",
            "params": {
              "payload": {
                "code": "vrc/relationships/issue:notAccepted",
                "message": "refused",
                "retryable": false,
                "details": {
                  "pad": ""
                },
                "inResponseTo": {
