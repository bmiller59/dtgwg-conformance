      },
      "clarify": "The default retryable column is a SHOULD that yields to task-specific knowledge; the carrier has none, so the vector asserts the default (docs/04 section 11). Not gating.",
      "clarifyClass": "vector-overreads",
      "clarifySince": "0.1.0-draft",
      "clarifyQuestions": [],
      "steps": [
        {
          "send": {
            "template": "carrier.request",
            "params": {
              "recipient": "$X"
            }
          },
          "expect": {
            "disposition": "error",
            "code": "wrongRecipient",
            "retryable": false,
            "noSideEffect": true
          }
        },
        {
          "send": {
            "template": "carrier.request",
            "params": {
              "id": "$id(req2)",
              "payload": {
                "$carrierInvalid": true
              }
            }
          },
          "expect": {
            "disposition": "error",
            "code": "malformedRequest",
            "retryable": false,
            "noSideEffect": true
          }
        },
        {
          "send": {
            "template": "carrier.request",
            "params": {
              "id": "$id(req3)",
              "type": "https://trusttasks.org/spec/conformance/gadget/0.1"
            }
          },
          "expect": {
            "disposition": "error",
            "code": "unsupportedType",
            "retryable": false,
            "noSideEffect": true
          }
        },
        {
          "send": {
            "template": "carrier.request",
            "params": {
              "id": "$id(req4)"
            },
            "mutate": [
              {
                "op": "set",
                "path": "/threadId",
                "value": "urn:uuid:tampered",
                "afterSign": true
              }
            ]
          },
          "expect": {
            "disposition": "error",
            "code": "proofInvalid",
            "retryable": false,
            "noSideEffect": true
          }
        }
      ],
      "advisoryMutants": [
        "retryableAlways"
      ],
      "requires": [
        "carrier:consequential"
      ],
      "synthetic": true
    },
