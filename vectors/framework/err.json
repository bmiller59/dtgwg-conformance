    {
      "id": "ERR-008",
      "title": "an inbound error carrying an extended code and oversized details is not answered",
      "tier": 1,
      "spec": [
        "SPEC.md:1290 (8.2.2 a receiver ignores oversized details and still honours the code)",
        "docs/04 section 13 (error hygiene: an inbound error is answered with nothing)"
      ],
