    {
      "id": "CTRL-004",
      "title": "an unsigned control document is refused unsupportedType: the type is checked before the proof",
      "tier": 1,
      "spec": [
        "SPEC.md:1698 (11.8)",
        "SPEC.md:1013 (7.2 item 3 type before item 7 proof)",
        "SPEC.md:1641 (11.1 a control document MUST carry a proof, for a consumer that implements control)"
      ],
      "source": {
        "slug": "trust-task-framework",
        "version": "0.6.0",
        "channel": "registry",
        "ref": "kit:SPEC.md",
        "pinnedDigest": "sha256:731a57fc324eea726393716adcddf28d7ca3fb7242335fe025428775b29fd292",
        "tfRef": {
          "repoPath": "SPEC.md",
          "commit": "bd0c05013277b83f23fa90db699671ebb48dd24c",
          "status": "main"
        },
        "tfCommit": "bd0c05013277b83f23fa90db699671ebb48dd24c",
        "specHash": "sha256:2bb5ae11da4dd6394499021b5ecda94ee38d61cf9668e2018e3dc809f3e66568"
      },
      "clarify": "SPEC.md 7.2 lists the checks (type at item 3, proof at item 7) but no sentence makes the order of the list normative. An implementation that refuses an unsigned document of a type it does not serve with proofRequired, before it routes the type, tells an unauthenticated caller nothing about what it serves (VTI does). The document is refused either way and never executed. Not gating.",
      "clarifyClass": "vector-overreads",
      "clarifySince": "0.1.0-draft",
      "clarifyQuestions": [],
      "skipIfOptional": [
        "control"
      ],
      "mutants": [
        "controlProofFirst",
        "controlAccepted"
      ],
      "steps": [
        {
          "send": {
            "template": "control.cancel",
            "params": {
              "id": "$id(ctl)",
              "payload": {
                "operation": "cancel",
                "target": {
                  "id": "$id(req)"
                }
              }
            },
            "sign": null
          },
          "expect": {
            "disposition": "error",
            "code": "unsupportedType",
            "noSideEffect": true
          }
        }
      ],
      "requires": [
        "carrier:consequential"
      ]
    }
