        "schemaHash": "sha256:d406cfbf00142bbf81f7edecafbeee334d8da20f8de59ccd35ab31c88d305624",
        "versionRole": "older"
      },
      "clarify": "As CEX-026: the decision is out of band (pending/approve) and the helper stands for it; the nonce and audience members are as for CEX-025. The kit specs are status draft. Not gating.",
      "clarifyClass": "spec-silent",
      "clarifySince": "2026-11-15",
      "clarifyQuestions": [],
      "requires": [
        "carrier:consequential",
        "https://trusttasks.org/spec/credential-exchange/query/0.1",
        "optional:trigger.holdCredential",
        "optional:trigger.queryDecision",
        "optional:observe.deferred",
        "optional:observe.pushed"
      ],
      "mutants": [
        "noPush",
        "pushedWrongThread",
        "pushedWrongRecipient",
        "pushedWrongType"
      ],
      "steps": [
        {
          "trigger": {
            "action": "holdCredential",
            "args": {
              "type": "https://example.org/conformance#ConformanceCredential"
            }
          }
        },
        {
          "send": {
            "template": "cex.query"
          },
          "expect": {
            "disposition": "any-refusal",
            "state": {
              "deferred": 1
            }
          }
        },
        {
          "trigger": {
            "action": "queryDecision",
            "args": {
              "thread": "$id(qry)",
              "decision": "approve"
            }
          }
        },
        {
          "observePushed": {
            "to": "$A",
            "type": "https://trusttasks.org/spec/credential-exchange/present/0.1",
            "threadId": "$id(qry)",
            "withinMs": 250,
            "pointer": {
              "/payload/vp_token/proof/challenge": "qry-nonce-0001",
              "/payload/vp_token/proof/domain": "$A"
            }
          }
        }
      ]
    },
