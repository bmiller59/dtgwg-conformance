          }
        },
        {
          "observePushed": {
            "to": "$A",
            "type": "https://trusttasks.org/spec/credential-exchange/issue/0.1",
            "none": true,
            "withinMs": 100
          }
        }
      ]
    },
    {
      "id": "CEX-037",
      "title": "a deferred query that the holder's human approves is answered by a credential-exchange/present pushed to the verifier on the query's thread, bound to the query's nonce and the verifier",
      "tier": 1,
      "spec": [
        "specs/credential-exchange/present/0.1/spec.md:77 (Producer: reply on the query's thread; for a deferred query, present on the original thread once approval lands; bind the verifier's nonce and audience) [kit spec status: draft]",
        "specs/credential-exchange/query/0.1/spec.md (\"If approved, the holder presents on the original thread.\")"
      ],
      "source": {
        "slug": "credential-exchange/present",
        "version": "0.1",
        "channel": "registry",
        "ref": "kit:specs/credential-exchange/present/0.1",
