      },
      "clarify": null,
      "requires": [
        "binding:didcomm",
        "optional:authorised"
      ],
      "steps": [
        {
          "send": {
            "document": {
              "id": "$id(s1)",
              "type": "https://trusttasks.org/spec/witness/session/0.2",
              "issuer": "$A",
              "recipient": "$iut",
              "issuedAt": "$now+0s",
              "payload": {
