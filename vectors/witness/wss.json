        "specs/witness/session/0.2/payload.schema.json (draft) Response (challenge minLength 16, domain minLength 1)"
      ],
      "source": {
        "slug": "witness/session",
        "version": "0.2",
        "channel": "registry",
        "ref": "kit:specs/witness/session/0.2",
