  "scenarios": [
    {
      "id": "FC-DEV-001",
      "title": "device lifecycle: the phone registers itself with its agent, sends a heartbeat, lists the agent's devices and sets its wake channel; a second phone (a stand-in) is then removed by the wallet's own remove flow (wipe, then revoke its access-list entry): its entry and binding are gone and this phone's binding remains",
      "spec": [
        "TF specs/device/register/0.2/spec.md (the device claims its binding; one per consumer DID)",
        "TF specs/device/heartbeat/0.3/spec.md (a registered device tells the maintainer it is still here)",
        "TF specs/device/list/0.3/spec.md (enumerate the bindings)",
        "TF specs/device/set-wake/0.2/spec.md (record how to wake the device)",
        "TF specs/device/wipe/0.2/spec.md (wipe a registered device)",
        "docs/26-paired-ceremonies.md section 5"
      ],
