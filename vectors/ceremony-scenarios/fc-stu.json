  "family": "ceremony-scenarios",
  "evidence": "complete-ceremony",
  "ceremony": {
    "name": "Step-up of a gated task (wallet and agent)",
    "channel": "proposed",
    "choreography": "docs/26-paired-ceremonies.md section 4: a gated task is held, the phone answers the approve-request, the retried task runs once; the hold as a next step (SPEC 8.6) beside the deployed error shape; negatives for a declined step-up, a changed approval and an unknown challenge"
  },
  "scenarios": [
    {
      "id": "FC-STU-001",
      "title": "step-up of a gated task, at the overlap of the shapes in use: the agent holds a grant, the wallet answers the step-up approve-request with an approve-response 0.7 (approved, signed by the member's DID), the agent records it and the retried grant runs once; the hold may be a next step (the specification) or the error shape deployed agents use today",
      "spec": [
        "TF specs/auth/step-up/approve-request/0.5/spec.md (the relying party asks the subject's approver to ratify an elevation; the request carries a challenge and the evidence it accepts)",
        "TF specs/auth/step-up/approve-response/0.7/spec.md (the approver's answer echoes subject and challenge; didSigned evidence is a proof by the approver's own DID for assertionMethod; the agent records it)",
        "SPEC.md 8.6 (a hold is a next step)",
        "docs/26-paired-ceremonies.md section 4 (step-down: the hold's shape is the one point where the specification and the deployed agents differ)"
      ],
      "source": {
        "slug": "auth/step-up/approve-response",
        "version": "0.7",
        "channel": "proposed",
