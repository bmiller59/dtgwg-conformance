      },
      "clarify": "Which code a contested thread yields is a design rule (permissionDenied), not specification text; the specification only forbids treating validation as authorization (item 10). Not gating.",
      "clarifyClass": "vector-overreads",
      "clarifySince": "0.1.0-draft",
      "clarifyQuestions": [],
      "requires": [
        "carrier:consequential",
        "https://trusttasks.org/spec/vrc/relationships/propose/0.1",
        "optional:trigger.consent"
      ],
      "mutants": [
        "proposeLeaksForeignOutcome"
      ],
      "steps": [
        {
          "trigger": {
            "action": "policy",
            "args": {
              "propose": "accept"
            }
          }
        },
        {
          "send": {
            "template": "propose.request"
          },
          "capture": {
            "ibr": "/payload/relationshipDid"
          },
          "expect": {
            "disposition": "response",
            "type": "https://trusttasks.org/spec/vrc/relationships/propose/0.1#response",
            "match": {
              "/payload/relationshipDid": "^did:"
            },
            "state": {
              "handled": 1
            }
          }
        },
        {
          "at": "+5s",
          "send": {
            "template": "propose.request",
            "params": {
              "id": "$id(req2)",
              "threadId": "$id(req)",
              "issuer": "$X",
              "payload": {
                "relationshipDid": "$S"
              }
            },
            "from": "X"
          },
          "expect": {
            "disposition": "error",
            "code": "permissionDenied",
            "noSideEffect": true
          }
        }
      ]
    }
  ]
