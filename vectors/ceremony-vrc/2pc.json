              }
            }
          }
        },
        {
          "at": "+3700s",
          "send": {
            "template": "ceremony.approve",
            "from": "A",
            "params": {
              "id": "$id(app2)",
              "issuer": "$A"
            }
          },
          "expect": {
            "disposition": "error",
            "code": "taskFailed",
            "retryable": false,
            "noSideEffect": true,
            "pointer": {
              "/payload/details/reason": "deadlineLapsed"
            },
            "state": {
              "effects": 0
            },
