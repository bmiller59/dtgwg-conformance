        "optional:ceremony",
        "optional:trigger.ceremonyDeadline"
      ],
      "mutants": [
        "cerNoDeadline",
        "cerLateErrorUnstable",
        "cerDeadlineExpiredCode"
      ],
      "steps": [
        {
          "trigger": {
            "action": "ceremonyDeadline",
            "args": {
              "seconds": 3600
            }
          }
        },
        {
          "send": {
            "template": "ceremony.begin",
            "from": "A"
          },
          "expect": {
            "disposition": "next-step",
            "hold": true,
            "noSideEffect": true,
            "state": {
              "effects": 0
            },
            "pointer": {
              "/threadId": "$id(begin)"
            }
          }
        },
        {
          "at": "+3601s",
          "send": {
            "template": "ceremony.approve",
            "from": "X"
