+# LOCAL TEST-ONLY PATCH (class D stand-in, bam wire3 D407/D430): the DID resolver of the mediator may fetch did:webvh / did:web
+# from loopback and private hosts (HostPolicy::AllowPrivate instead of the default PublicOnly). Never for production.
+RUN set -e; M=crates/affinidi-messaging-mediator; \
+    for f in $M/src/common/config/mod.rs $M/src/builder.rs; do \
+      test "$(grep -c 'with_cache_capacity(' $f)" -ge 1; \
+      sed -i 's/\.with_cache_capacity(/.with_host_policy(affinidi_did_web::HostPolicy::AllowPrivate).with_cache_capacity(/' $f; \
+      grep -q 'HostPolicy::AllowPrivate' $f; \
+    done; \
+    grep -n '^\[dependencies\]' $M/Cargo.toml; \
+    sed -i '0,/^\[dependencies\]/s//[dependencies]\naffinidi-did-web = "0.1.6"/' $M/Cargo.toml; \
+    grep -n 'affinidi-did-web' $M/Cargo.toml
+RUN cargo build --release -p affinidi-messaging-mediator --features "${FEATURES}"
 RUN cargo build --release --locked -p affinidi-messaging-mediator-setup \
