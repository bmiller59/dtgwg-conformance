# SPDX-License-Identifier: Apache-2.0
# Template for the in-process ballot-box host: the launcher copies it to a build directory outside both repositories, replacing @VTI_ROOT@ with the path of the VTI checkout (read only) and copying its Cargo.lock.
[package]
name = "vti-ballot-host"
version = "0.1.0"
edition = "2024"
publish = false

[workspace]

[dependencies]
vti-voting-service = { path = "@VTI_ROOT@/vti-voting-service" }
vti-voting = { path = "@VTI_ROOT@/vti-voting" }
vti-common = { path = "@VTI_ROOT@/vti-common", features = ["host-session"] }
vta-sdk = { path = "@VTI_ROOT@/vta-sdk", features = ["didcomm", "provision-client", "tsp", "crypto-provider"] }
trust-tasks-rs = { version = "0.36.2", default-features = false, features = ["validate"] }
tokio = { version = "1.49", features = ["full"] }
serde_json = "1"
axum = "0.8"
chrono = "0.4"
uuid = { version = "1", features = ["v4"] }

[profile.dev]
debug = false
incremental = true

[profile.dev.package."*"]
debug = false
opt-level = 1
