    "check:docs": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/regen.ts --check",
    "coverage-matrix": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/coverage/matrix/cli.ts"
  },
  "dependencies": {
    "@openvtc/trust-tasks": "0.29.0"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
