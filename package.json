    "tf-alignment": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/tf-alignment.ts",
    "backfill-spec-hashes": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/backfill-spec-hashes.ts",
    "repin": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/repin.ts",
    "pins": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/refresh-pins.ts",
    "governance": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/governance/cli.ts",
    "suite": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/runner/cli.ts",
    "resolve-tf-refs": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/resolve-tf-refs.ts",
    "at-a-glance": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/at-a-glance.ts",
    "docs-blocks": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/docs-blocks.ts",
